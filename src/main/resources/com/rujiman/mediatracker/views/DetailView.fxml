<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<!-- Detalle con estilo "ficha" (rediseño, dirección A):
     1. Banda superior teñida con el color del tipo y el póster
        desenfocado de fondo; póster, tipo, título, datos, descripción,
        géneros, progreso y UNA acción principal.
     2. Debajo: episodios/capítulos en cuadrícula y recomendaciones.
     Ancho fijo de 1240 px centrado, igual que la vitrina de Inicio. -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rujiman.mediatracker.controllers.DetailViewController"
            styleClass="bg-base">

    <center>
        <ScrollPane fx:id="detailScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="scroll-pane-transparent, bg-base">

            <VBox fx:id="detailContainer" alignment="TOP_CENTER" styleClass="bg-base">

                <!-- ===================== BANDA SUPERIOR ===================== -->
                <StackPane fx:id="heroBand" alignment="TOP_CENTER">
                    <ImageView fx:id="heroBackdrop" preserveRatio="false" managed="false" mouseTransparent="true"/>

                    <VBox fx:id="heroInner" spacing="12" maxWidth="1240" prefWidth="1240">
                        <padding><Insets top="20" right="32" bottom="40" left="32"/></padding>

                        <Button fx:id="backButton" text="Volver" onAction="#onBack" styleClass="btn-ghost"/>

                        <HBox spacing="40" alignment="TOP_LEFT">
                            <StackPane fx:id="posterBox" minWidth="240" minHeight="360" maxWidth="240" maxHeight="360"
                                       styleClass="detail-poster">
                                <ImageView fx:id="detailImage" fitWidth="240" fitHeight="360" preserveRatio="false"/>
                            </StackPane>

                            <VBox spacing="14" HBox.hgrow="ALWAYS">
                                <Label fx:id="typeBadge" text="TIPO" styleClass="detail-type-badge"/>
                                <Label fx:id="detailTitle" text="Título" wrapText="true" styleClass="detail-title"/>

                                <HBox spacing="18" alignment="CENTER_LEFT">
                                    <Label fx:id="detailYear" text="2023" styleClass="detail-meta"/>
                                    <Label fx:id="detailScore" text="Nota 85/100" styleClass="detail-meta"/>
                                </HBox>

                                <Label fx:id="detailPlatforms" text="" wrapText="true" styleClass="detail-meta"/>

                                <!-- Se mantiene por compatibilidad; la descripción ya no lleva cabecera -->
                                <Label fx:id="descriptionHeaderLabel" text="Descripción" visible="false" managed="false"/>
                                <Label fx:id="detailDescription" text="" wrapText="true" maxWidth="760"
                                       styleClass="detail-description"/>

                                <FlowPane fx:id="detailGenresBox" hgap="8" vgap="8"/>

                                <!-- Progreso (solo anime/series/manga con episodios conocidos) -->
                                <VBox fx:id="progressBox" spacing="8" maxWidth="520" visible="false" managed="false">
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Tu progreso" styleClass="detail-progress-title"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="progressCountLabel" text="" styleClass="detail-meta"/>
                                    </HBox>
                                    <StackPane fx:id="progressTrack" alignment="CENTER_LEFT"
                                               prefHeight="8" minHeight="8" maxHeight="8" prefWidth="520" maxWidth="520"
                                               styleClass="detail-progress-track">
                                        <Region fx:id="progressFill" prefHeight="8" maxHeight="8" maxWidth="0"
                                                styleClass="detail-progress-fill"/>
                                    </StackPane>
                                </VBox>

                                <!-- Acciones: UNA principal (color del tipo) + secundarias -->
                                <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                                    <Button fx:id="primaryActionButton" text="Marcar episodio 1"
                                            visible="false" managed="false" onAction="#onPrimaryAction"/>
                                    <Button fx:id="viewedButton" text="Marcar como visto" onAction="#onToggleViewed"/>
                                    <Button fx:id="openExternalButton" text="Abrir en navegador"
                                            styleClass="btn-secondary" onAction="#onOpenExternal"/>
                                    <Button fx:id="trailerButton" text="Ver tráiler"
                                            visible="false" managed="false" styleClass="btn-secondary"
                                            onAction="#onOpenTrailer"/>
                                    <Button fx:id="favoriteButton" styleClass="btn-icon" onAction="#onToggleFavorite"/>
                                    <Button fx:id="planButton" styleClass="btn-icon" onAction="#onTogglePlan"/>
                                    <Button fx:id="moveToFavoritesButton" text="Mover a Favoritos"
                                            visible="false" managed="false" styleClass="btn-secondary"
                                            onAction="#onMoveToFavorites"/>
                                </FlowPane>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Tu nota" styleClass="detail-meta"/>
                                    <HBox fx:id="userRatingStars" spacing="4" alignment="CENTER_LEFT"/>
                                </HBox>

                                <!-- Preview de 30 s (solo canciones sueltas de Deezer) -->
                                <VBox fx:id="previewSection" spacing="6" visible="false" managed="false">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Button fx:id="previewButton"
                                                text="▶ Escuchar preview (30s)"
                                                styleClass="btn-secondary"
                                                onAction="#onTogglePreview"/>
                                        <Label fx:id="previewTimeLabel" text="0:00 / 0:30" styleClass="detail-meta"/>
                                    </HBox>
                                    <ProgressBar fx:id="previewProgressBar"
                                                 progress="0"
                                                 prefWidth="260"
                                                 style="-fx-accent: #4dec9e;"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>

                <!-- ===================== CONTENIDO ===================== -->
                <VBox fx:id="contentInner" spacing="36" maxWidth="1240" prefWidth="1240">
                    <padding><Insets top="32" right="32" bottom="64" left="32"/></padding>

                    <Separator fx:id="episodesSeparator" opacity="0" visible="false" managed="false"/>

                    <!-- Episodios (ANIME / SERIES) o capítulos (MANGA) en cuadrícula -->
                    <VBox fx:id="episodesSection" spacing="14" visible="false" managed="false">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="episodesHeaderLabel" text="Episodios" styleClass="detail-section-title"/>
                            <Label text="Clic para marcar · Mayús + clic marca hasta ese" styleClass="detail-hint"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="markAllWatchedButton" text="Marcar todos"
                                    styleClass="btn-secondary-sm" onAction="#onMarkAllEpisodesWatched"/>
                            <Button fx:id="unmarkAllWatchedButton" text="Desmarcar todos"
                                    styleClass="btn-secondary-sm" onAction="#onUnmarkAllEpisodesWatched"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="jumpToEpisodeLabel" text="Ya he visto hasta el episodio" styleClass="detail-hint"/>
                            <TextField fx:id="jumpToEpisodeField" promptText="nº" prefWidth="70"
                                       styleClass="text-field-base"/>
                            <Button fx:id="jumpToEpisodeButton" text="Ir" styleClass="btn-secondary-sm"
                                    onAction="#onJumpToEpisode"/>
                        </HBox>

                        <VBox fx:id="episodesList" spacing="12"/>
                    </VBox>

                    <!-- Canciones del álbum (solo MUSIC tipo álbum) -->
                    <VBox fx:id="trackCountSection" spacing="4" visible="false" managed="false">
                        <Label fx:id="trackCountLabel" text="0 canciones" styleClass="detail-meta"/>
                    </VBox>

                    <Separator fx:id="recommendationsSeparator" opacity="0" visible="false" managed="false"/>

                    <!-- Recomendaciones, cargadas en segundo plano -->
                    <VBox fx:id="recommendationsSection" spacing="14" visible="false" managed="false">
                        <Label fx:id="recommendationsHeaderLabel" text="Si te gusta, también te gustará"
                               wrapText="true" styleClass="detail-section-title"/>
                        <FlowPane fx:id="recommendationsGrid" hgap="14" vgap="14"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
