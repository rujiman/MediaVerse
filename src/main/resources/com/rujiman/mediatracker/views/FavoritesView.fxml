<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Favoritos (rediseño): chips por tipo, carpetas con arrastrar y
     tarjetas. Todo el contenido lo construye FavoritesViewController. -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rujiman.mediatracker.controllers.FavoritesViewController"
            fx:id="favoritesScroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="scroll-pane-transparent, bg-base">

    <VBox alignment="TOP_CENTER" styleClass="bg-base">
        <VBox fx:id="favoritesRoot" spacing="24" maxWidth="1304" prefWidth="1304">
            <padding><Insets top="32" right="32" bottom="64" left="32"/></padding>
        </VBox>
    </VBox>

</ScrollPane>
