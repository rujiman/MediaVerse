<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.rujiman.mediatracker.controllers.SearchController">

<BorderPane fx:id="mainLayout" styleClass="bg-base">

    <top>
        <VBox style="-fx-background-color: #1c1730; -fx-effect: dropshadow(gaussian, #000000aa, 10, 0, 0, 3);">
            <padding><Insets top="16" right="20" bottom="12" left="20"/></padding>
            <HBox spacing="12" alignment="CENTER">

                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Button fx:id="hamburgerButton"
                            text="☰"
                            onAction="#toggleNavMenu"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #f0eef5;
                                   -fx-font-size: 20px;
                                   -fx-cursor: hand;
                                   -fx-padding: 0 4 0 0;"/>

                    <!-- Logo + nombre: clicables, llevan a Inicio desde cualquier pantalla -->
                    <HBox spacing="14" alignment="CENTER_LEFT"
                          onMouseClicked="#goHome"
                          style="-fx-cursor: hand;">
                    <ImageView fitWidth="26" fitHeight="26" preserveRatio="true">
                        <image>
                            <Image url="@icons/mediaverse_logo.png"/>
                        </image>
                    </ImageView>
                    <!-- "Mediaverse" con el mismo degradado multicolor que
                         el resto de la identidad de marca (Login, bordes,
                         etc.), en vez del rosa de marca plano (.text-title).
                         -fx-text-fill SÍ admite linear-gradient en JavaFX
                         CSS, igual sintaxis que -fx-background-color. -->
                    <Label text="Mediaverse"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: linear-gradient(from 0% 0% to 100% 0%, #4dd9ec, #8b5cf6, #ec4dc0, #ecb14d);"/>
                    </HBox>

                    <Button fx:id="backToHomeButton"
                            text="← Volver"
                            onAction="#goHome"
                            visible="false" managed="false"
                            styleClass="btn-pill-neutral"
                            style="-fx-font-size: 12px; -fx-padding: 6 14 6 14;"/>
                </HBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <HBox fx:id="searchBarBox" spacing="8" alignment="CENTER" visible="false" managed="false">
                    <!-- Borde multicolor (mismo degradado de la paleta
                         Constelaciones que ya usamos en Login), en vez
                         del rosa de marca plano de antes. -->
                    <TextField fx:id="searchField"
                               promptText="Busca series, pelis, anime, manga, juegos, música o libros   (Ctrl+K)"
                               prefWidth="340"
                               styleClass="text-field-base"
                               style="-fx-border-color: linear-gradient(from 0% 0% to 100% 0%, #4dd9ec, #8b5cf6, #ec4dc0, #ecb14d);
                                      -fx-border-width: 2;
                                      -fx-border-radius: 20;"/>
                    <Button fx:id="searchButton"
                            text="Buscar"
                            onAction="#onSearch"
                            styleClass="btn-pill-brand"
                            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 0%, #4dd9ec, #8b5cf6, #ec4dc0, #ecb14d);"/>
                </HBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <!-- Aviso de actualización: solo aparece si GitHub tiene una versión nueva -->
                <Button fx:id="updateButton" text="Actualizar" visible="false" managed="false"
                        onAction="#onUpdate" styleClass="update-pill"/>

                <StackPane fx:id="profileIconContainer"
                           prefWidth="32" prefHeight="32"
                           maxWidth="32" maxHeight="32"
                           onMouseClicked="#toggleProfileMenu"
                           style="-fx-background-color: #ec4d80;
                                  -fx-background-radius: 50;
                                  -fx-cursor: hand;">
                    <ImageView fx:id="profileIcon"
                               fitWidth="32" fitHeight="32"
                               preserveRatio="true"
                               pickOnBounds="true"
                               visible="false"/>
                    <Label fx:id="profileInitialLabel"
                           text="U"
                           style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </StackPane>

            </HBox>


            <HBox fx:id="filterBarBox" spacing="8" alignment="CENTER_LEFT" visible="false" managed="false" style="-fx-padding: 12 0 0 0;">
                <ToggleButton fx:id="filterAll" text="Todo" selected="true"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterAnime" text="🎌 Anime"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterSeries" text="📺 Series"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterMovie" text="🎬 Películas"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterMusic" text="🎵 Música"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterGame" text="🎮 Juegos"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterManga" text="📖 Manga"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
                <ToggleButton fx:id="filterBook" text="📚 Libros"
                              onAction="#onFilterChanged"
                              styleClass="filter-toggle"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="centerContent">

            <StackPane fx:id="homeContainer" visible="true">
            </StackPane>

            <VBox fx:id="searchContentBox" visible="false">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <StackPane fx:id="statusPane" VBox.vgrow="ALWAYS">
                    <VBox spacing="16" alignment="CENTER">
                        <ProgressIndicator fx:id="loadingSpinner"
                                           visible="false"
                                           managed="false"
                                           prefWidth="48" prefHeight="48"
                                           style="-fx-progress-color: #ec4d80;"/>
                        <Label fx:id="statusLabel"
                               text="Busca tu próxima obsesión: anime, series, pelis, música o videojuegos ✨"
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="text-dim"
                               style="-fx-font-size: 16px;"/>
                    </VBox>
                </StackPane>

                <ScrollPane fx:id="scrollPane"
                            fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            visible="false"
                            managed="false"
                            styleClass="scroll-pane-transparent">
                    <FlowPane fx:id="resultsGrid"
                              hgap="16" vgap="16"
                              styleClass="bg-transparent">
                        <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
                    </FlowPane>
                </ScrollPane>

            </VBox>

            <!-- Overlay de detalle / favoritos / listas: ahora vive DENTRO
                 del centro del BorderPane (antes tapaba toda la ventana),
                 así la cabecera con ☰, logo y perfil siempre queda visible
                 y se puede saltar a cualquier sitio sin ir "Volver" a "Volver". -->
            <StackPane fx:id="detailOverlayContainer" visible="false" styleClass="bg-base">
            </StackPane>

        </StackPane>
    </center>

</BorderPane>

    <StackPane fx:id="profileMenu" visible="false" managed="false"
               style="-fx-background-color: #1c1730;
                      -fx-effect: dropshadow(gaussian, #000000cc, 16, 0, 0, 4);
                      -fx-background-radius: 12;"
               prefWidth="220" maxWidth="220"
               prefHeight="520" maxHeight="520"
               StackPane.alignment="TOP_RIGHT">
        <StackPane.margin><Insets top="64" right="20"/></StackPane.margin>

        <VBox spacing="12" alignment="CENTER">
            <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>

            <StackPane prefWidth="64" prefHeight="64"
                       maxWidth="64" maxHeight="64"
                       onMouseClicked="#onChangeProfilePicture"
                       style="-fx-background-color: #ec4d80;
                              -fx-background-radius: 50;
                              -fx-cursor: hand;">
                <ImageView fx:id="profilePicture"
                           fitWidth="64" fitHeight="64"
                           preserveRatio="true"
                           visible="false"/>
                <Label fx:id="profileInitialLabelBig"
                       text="U"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 22px;"/>
            </StackPane>

            <Label fx:id="usernameLabel"
                   text="Usuario"
                   wrapText="true"
                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <Separator/>

            <Button text="Cambiar nombre de usuario"
                    onAction="#onChangeUsername"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Button text="Cambiar contraseña"
                    onAction="#onChangePassword"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Button text="Claves de API"
                    onAction="#onApiKeys"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Button text="Copia de seguridad"
                    onAction="#onBackup"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Button text="Acerca de MediaVerse"
                    onAction="#onAbout"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Button text="Buscar actualizaciones"
                    onAction="#onCheckUpdates"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>

            <Label fx:id="versionLabel" text="MediaVerse" styleClass="text-dim"/>

            <Separator/>

            <!-- Mismo botón "Cerrar sesión" que ya existe en el menú
                 lateral (#logout), ahora también accesible desde aquí
                 sin tener que abrir el menú grande solo para salir. -->
            <Button text="Cerrar sesión"
                    onAction="#logout"
                    maxWidth="Infinity"
                    styleClass="btn-flat-brand"
                    style="-fx-font-size: 12px;"/>
        </VBox>
    </StackPane>

</StackPane>
