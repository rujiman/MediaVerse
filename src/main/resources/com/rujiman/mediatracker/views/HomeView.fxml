<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Inicio en formato VITRINA (perfil para "flexear" tus gustos).
     Todo el contenido lo construye HomeController por código, porque
     depende de los favoritos de cada usuario; aquí solo va el
     contenedor. Ancho fijo de 1240 px, centrado. -->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rujiman.mediatracker.controllers.HomeController"
            fx:id="homeScroll"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="scroll-pane-transparent, bg-base">

    <VBox fx:id="homeRoot" spacing="28" alignment="TOP_CENTER" styleClass="bg-base">
        <padding><Insets top="28" right="32" bottom="64" left="32"/></padding>
    </VBox>

</ScrollPane>
