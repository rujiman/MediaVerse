<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<!-- Login / registro (rediseño): pantalla partida.
     Izquierda: marca + mosaico de "portadas" de cada tipo de contenido
     (flota suavemente, ver LoginController). Derecha: formulario limpio.
     Este es el único sitio de la app donde se usa el degradado de marca
     a lo grande: es la "portada" de MediaVerse. -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.rujiman.mediatracker.controllers.LoginController"
            styleClass="login-root">

    <left>
        <StackPane fx:id="brandPane" prefWidth="460" minWidth="460" maxWidth="460" styleClass="login-brand">

            <!-- Mosaico decorativo, girado; cada tarjeta lleva el color de su tipo -->
            <!-- managed="false": el mosaico es más grande que el panel y no debe
                 influir en su tamaño (si no, empujaba el texto de marca fuera
                 de la ventana). Se coloca a mano con layoutX/layoutY. -->
            <GridPane fx:id="brandMosaic" hgap="14" vgap="14" rotate="-12" opacity="0.9" mouseTransparent="true"
                      managed="false" layoutX="-30" layoutY="-70">
                <Label text="JUEGOS"    styleClass="login-tile, login-tile-game"   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label text="ANIME"     styleClass="login-tile, login-tile-anime"  GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="SERIES"    styleClass="login-tile, login-tile-series" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label text="PELÍCULAS" styleClass="login-tile, login-tile-movie"  GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label text="MÚSICA"    styleClass="login-tile, login-tile-music"  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="LIBROS"    styleClass="login-tile, login-tile-book"   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Label text="MANGA"     styleClass="login-tile, login-tile-manga"  GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label text="JUEGOS"    styleClass="login-tile, login-tile-game"   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="ANIME"     styleClass="login-tile, login-tile-anime"  GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Label text="SERIES"    styleClass="login-tile, login-tile-series" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Label text="MANGA"     styleClass="login-tile, login-tile-manga"  GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="PELÍCULAS" styleClass="login-tile, login-tile-movie"  GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            </GridPane>

            <!-- Velo para que el texto de marca se lea sobre el mosaico -->
            <Region styleClass="login-brand-veil" mouseTransparent="true"/>

            <VBox alignment="BOTTOM_LEFT" spacing="10" StackPane.alignment="BOTTOM_LEFT" maxHeight="Infinity">
                <padding><Insets top="40" right="40" bottom="44" left="40"/></padding>
                <HBox spacing="12" alignment="CENTER_LEFT">
                    <ImageView fitWidth="44" fitHeight="44" preserveRatio="true">
                        <image><Image url="@icons/mediaverse_logo.png"/></image>
                    </ImageView>
                    <Label text="Mediaverse" styleClass="login-brand-name"/>
                </HBox>
                <Label text="Todo lo que ves, juegas, escuchas y lees. En un solo universo."
                       wrapText="true" styleClass="login-brand-tagline"/>
            </VBox>
        </StackPane>
    </left>

    <center>
        <StackPane fx:id="mainStack" alignment="CENTER" styleClass="login-root">

            <!-- ===================== INICIAR SESIÓN ===================== -->
            <VBox fx:id="LoginPanel" alignment="CENTER_LEFT" spacing="22" maxWidth="380">
                <VBox spacing="6">
                    <Label text="Bienvenido de nuevo" styleClass="login-title"/>
                    <Label text="Entra para ver tu vitrina y seguir donde lo dejaste." wrapText="true" styleClass="login-subtitle"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Usuario" styleClass="login-label"/>
                    <TextField fx:id="usernameLoginField" promptText="Tu usuario" styleClass="login-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Contraseña" styleClass="login-label"/>
                    <PasswordField fx:id="passwordLoginField" promptText="Tu contraseña" styleClass="login-field"/>
                </VBox>

                <Label fx:id="loginErrorLabel" visible="false" managed="false" wrapText="true" styleClass="login-error"/>

                <Button fx:id="loginButton" text="Iniciar sesión" onAction="#onLogin"
                        maxWidth="Infinity" styleClass="login-primary"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="¿No tienes cuenta?" styleClass="login-subtitle"/>
                    <Button fx:id="switchToRegisterButton" text="Crear cuenta" onAction="#switchToRegister"
                            styleClass="login-link"/>
                </HBox>
            </VBox>

            <!-- ===================== CREAR CUENTA ===================== -->
            <VBox fx:id="RegisterPanel" alignment="CENTER_LEFT" spacing="20" maxWidth="380" visible="false">
                <VBox spacing="6">
                    <Label text="Crea tu cuenta" styleClass="login-title"/>
                    <Label text="Monta tu vitrina y empieza a llevar la cuenta de todo." wrapText="true" styleClass="login-subtitle"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Usuario" styleClass="login-label"/>
                    <TextField fx:id="usernameRegisterField" promptText="Mínimo 3 caracteres" styleClass="login-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Contraseña" styleClass="login-label"/>
                    <PasswordField fx:id="passwordRegisterField" promptText="Mínimo 4 caracteres" styleClass="login-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Confirmar contraseña" styleClass="login-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Repite la contraseña" styleClass="login-field"/>
                </VBox>

                <Label fx:id="registerErrorLabel" visible="false" managed="false" wrapText="true" styleClass="login-error"/>

                <Button fx:id="registerButton" text="Crear cuenta" onAction="#onRegister"
                        maxWidth="Infinity" styleClass="login-primary"/>

                <HBox alignment="CENTER" spacing="6">
                    <Label text="¿Ya tienes cuenta?" styleClass="login-subtitle"/>
                    <Button fx:id="switchToLoginButton" text="Iniciar sesión" onAction="#switchToLogin"
                            styleClass="login-link"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
